# OpenAI-compatible API settings. Required unless you use --no-llm or --export-prompt.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Optional: path to a Netscape cookies.txt file mounted inside the container.
# Leave empty to use the built-in default: /app/cookies/cookies.txt if it exists.
VIDEO_SUMMARY_COOKIES=

# Optional: let yt-dlp read cookies from a browser profile, e.g. edge, chrome, firefox.
# In Docker this only works if the browser profile is mounted into the container.
VIDEO_SUMMARY_COOKIES_FROM_BROWSER=
